require "base64"
require "fileutils"
require "shellwords"
require "tmpdir"

# deliver, whose upload_to_app_store this ends in
require "deliver"

# Wait for App Store Connect to list uploaded screenshots without resending them.
# Patch via class_eval because Fastlane evaluates this file in its own namespace.
LOOKS = 7
LOOK_AGAIN_AFTER = 30
WAITS_AT_MOST = (LOOKS - 1) * LOOK_AGAIN_AFTER

unless ::Deliver::UploadScreenshots.instance_method(:retry_upload_screenshots_if_needed).arity == 7
  FastlaneCore::UI.user_error!("deliver has moved the screenshot retry this patches - it would send every picture twice")
end

# locals, captured by the block below: a constant written inside it would be
# looked up in this file's scope, which is the trap described above
looks = LOOKS
look_again_after = LOOK_AGAIN_AFTER
waits_at_most = WAITS_AT_MOST

::Deliver::UploadScreenshots.class_eval do
  define_method(:retry_upload_screenshots_if_needed) do |_iterator, states, _count, _tries, _timeout, localizations, screenshots_per_language|
    failed = states.fetch("FAILED", 0)
    FastlaneCore::UI.user_error!("App Store Connect could not process #{failed} screenshot(s)") if failed > 0
    return if screenshots_per_language.empty?

    looks.times do |look|
      # a new iterator every time: the one deliver counted with asked the store
      # before the last pictures were listed, and holds on to that answer
      return if verify_local_screenshots_are_uploaded(::Deliver::AppScreenshotIterator.new(localizations), screenshots_per_language)
      break if look == looks - 1

      FastlaneCore::UI.message("the store has not listed every screenshot yet - looking again in #{look_again_after}s")
      sleep(look_again_after)
    end

    FastlaneCore::UI.user_error!("App Store Connect is still not listing every screenshot, #{waits_at_most}s after all of them were sent without error. Nothing was sent twice, so the set is at worst short - look at it before submitting.")
  end
end

# The patch above is silent when it fails to apply, so prove it applied: the
# method has to come from this file now, not from the gem.
patched_from, = ::Deliver::UploadScreenshots.instance_method(:retry_upload_screenshots_if_needed).source_location
unless patched_from.to_s.end_with?("Fastfile")
  FastlaneCore::UI.user_error!("the deliver patch did not take (retry still comes from #{patched_from}) - screenshots would go up twice")
end

default_platform(:ios)

# The app name selects its metadata override directory.
APPS = {
  pro: { name: "pro", scheme: "ODR Full", app_identifier: "at.tomtasche.reader" },
  lite: { name: "lite", scheme: "ODR Lite", app_identifier: "at.tomtasche.reader.lite1" },
}.freeze

# Resolve paths before lane and action working directories diverge.
IPA_DIR = File.expand_path("../build").freeze

# Absolute for the same reason. They resolve the repository from their own path,
# so they do not care which of the two they are called from.
STORE_LISTING = File.expand_path("../scripts/store_listing.py").freeze
STORE_SCREENSHOTS = File.expand_path("../scripts/store_screenshots.py").freeze
FRAME_SCREENSHOTS = File.expand_path("../scripts/frame-screenshots.py").freeze
MAKE_DOCUMENTS = File.expand_path("../scripts/make-screenshot-documents.py").freeze

# Where snapshot writes, and where the framed set goes. Neither is committed:
# a picture of the app is worth what the build it was taken from is.
SCREENSHOT_DIR = File.expand_path("screenshots").freeze
FRAMED_DIR = File.expand_path("framed").freeze

# Reuse one build across screenshot devices and locales.
SCREENSHOT_BUILD_DIR = File.expand_path("../build/screenshots").freeze

# Choose the newest installed iPhone and iPad models from these candidates.
SCREENSHOT_DEVICES = {
  "iphone" => ["iPhone 17 Pro Max", "iPhone 16 Pro Max", "iPhone 15 Pro Max"],
  "ipad" => ["iPad Pro 13-inch (M5)", "iPad Pro 13-inch (M4)", "iPad Pro (12.9-inch) (6th generation)"],
}.freeze

def dry_run?
  ENV["ODR_DRY_RUN"].to_s.strip == "true"
end

def github_output(name, value)
  output = ENV["GITHUB_OUTPUT"]
  File.open(output, "a") { |out| out.write("#{name}=#{value}\n") } if output
end

# The simulators this machine has, by the iOS they run: the same model name
# usually exists on several, and which one a bare name resolves to is luck.
def simulators_by_ios
  runtime = nil

  `xcrun simctl list devices available`.lines.each_with_object({}) do |line, found|
    if (version = line[/^-- iOS ([0-9.]+) --/, 1])
      runtime = version
      found[runtime] ||= []
    elsif runtime && (name = line[/^\s+(.+?) \([0-9A-F-]{36}\)/, 1])
      found[runtime] << name
    end
  end
end

# The newest iOS installed. The store shows what the app looks like now, and a
# picture taken on last year's iOS is last year's buttons.
def screenshot_ios
  given = ENV["ODR_SCREENSHOT_IOS"].to_s.strip
  return given unless given.empty?

  newest = simulators_by_ios.keys.max_by { |version| Gem::Version.new(version) }
  UI.user_error!("this machine has no iOS simulator runtime installed") unless newest

  newest
end

# Capture all supported locales unless ODR_SCREENSHOT_LANGUAGES narrows the set.
def screenshot_languages
  given = ENV["ODR_SCREENSHOT_LANGUAGES"].to_s.strip
  return given.split(",").map(&:strip) unless given.empty?

  sh(STORE_SCREENSHOTS, "--languages", log: false).split("\n").map(&:strip).reject(&:empty?)
end

# Choose one installed simulator per requested device type.
def screenshot_devices(ios)
  given = ENV["ODR_SCREENSHOT_DEVICES"].to_s.strip
  return given.split(",").map(&:strip) unless given.empty?

  available = simulators_by_ios.fetch(ios, [])

  screenshot_kinds.map do |kind|
    candidates = SCREENSHOT_DEVICES.fetch(kind)
    candidates.find { |name| available.include?(name) } ||
      UI.user_error!(
        "none of #{candidates.join(', ')} runs iOS #{ios}. That runtime has: " \
        "#{available.uniq.sort.join(', ')}. Set ODR_SCREENSHOT_DEVICES or " \
        "ODR_SCREENSHOT_IOS to pick by hand."
      )
  end
end

# Which of the two the run is for. Both unless one is named, so a run started by
# hand is the whole set - only the release splits them, a device to a runner.
def screenshot_kinds
  given = ENV["ODR_SCREENSHOT_DEVICE"].to_s.strip.downcase
  return SCREENSHOT_DEVICES.keys if given.empty?

  unless SCREENSHOT_DEVICES.key?(given)
    UI.user_error!("no such device: #{given}. One of #{SCREENSHOT_DEVICES.keys.join(', ')}.")
  end

  [given]
end

platform :ios do
  desc "Build a signed .ipa of the paid app"
  lane :buildPro do
    build_ipa(APPS[:pro])
  end

  desc "Build a signed .ipa of the ad supported app"
  lane :buildLite do
    build_ipa(APPS[:lite])
  end

  desc "Upload an already built Pro .ipa to App Store Connect"
  lane :uploadPro do
    upload_ipa(APPS[:pro])
  end

  desc "Upload an already built Lite .ipa"
  lane :uploadLite do
    upload_ipa(APPS[:lite])
  end

  desc "Write the paid app's listing, and ODR_VERSION's release notes, to the store"
  lane :uploadListingPro do
    upload_listing(APPS[:pro])
  end

  desc "Write the ad supported app's listing, and ODR_VERSION's release notes, to the store"
  lane :uploadListingLite do
    upload_listing(APPS[:lite])
  end

  desc "Take the App Store screenshots of both devices, in every locale the app is translated into"
  lane :screenshots do
    languages = screenshot_languages
    ios = screenshot_ios
    devices = screenshot_devices(ios)

    UI.message("photographing #{devices.join(' and ')} on iOS #{ios} in #{languages.join(', ')}")

    # Generate sample resources before Xcode discovers build inputs.
    sh(MAKE_DOCUMENTS)

    # Build once for all screenshot runs.
    scan(
      project: "OpenDocumentReader.xcodeproj",
      scheme: "ODR Screenshots",
      # not a device: this is the one build both simulators are photographed from
      destination: "generic/platform=iOS Simulator",
      derived_data_path: SCREENSHOT_BUILD_DIR,
      build_for_testing: true,
      skip_detect_devices: true
    )

    # Use Pro for both listings so ad and consent dialogs cannot obscure screenshots.
    # The run captures the edit screen a second time as Lite shows it.
    capture_ios_screenshots(
      project: "OpenDocumentReader.xcodeproj",
      scheme: "ODR Screenshots",
      devices: devices,
      # pinned, or the same model name on an older runtime answers instead and
      # the store gets a picture of last year's iOS
      ios_version: ios,
      languages: languages,
      output_directory: SCREENSHOT_DIR,
      # Use 9:41 and a full, non-charging battery.
      override_status_bar: true,
      override_status_bar_arguments:
        "--time 9:41 --dataNetwork wifi --wifiMode active --wifiBars 3 " \
        "--cellularMode active --cellularBars 4 --batteryState discharging --batteryLevel 100",
      # a rerun replaces the set rather than adding to it
      clear_previous_screenshots: true,
      # Snapshots.swift implements the handoff; no vendored SnapshotHelper.swift to check.
      skip_helper_version_check: true,
      # the runner has no browser to open the summary in, and no one watching it
      skip_open_summary: true,
      stop_after_first_error: true,
      # Run one simulator at a time to limit memory use.
      concurrent_simulators: false,
      # the build above, photographed as it stands
      derived_data_path: SCREENSHOT_BUILD_DIR,
      test_without_building: true,
      # Localize the simulator status bar as well as the app.
      localize_simulator: true
    )

    # Frame captures separately so design changes do not require new screenshots.
    sh(FRAME_SCREENSHOTS)

    # Validate complete sets; the release workflow checks combined device jobs.
    narrowed = %w[ODR_SCREENSHOT_LANGUAGES ODR_SCREENSHOT_DEVICE ODR_SCREENSHOT_DEVICES]
      .any? { |name| !ENV[name].to_s.strip.empty? }

    if narrowed
      UI.important("#{devices.join(', ')} in #{languages.join(', ')} is not a full set, so it is not checked")
    else
      sh(STORE_SCREENSHOTS, "--screenshots", FRAMED_DIR)
    end
  end

  desc "Build and upload the paid app"
  lane :deployPro do
    build_ipa(APPS[:pro])
    upload_ipa(APPS[:pro]) unless dry_run?
  end

  desc "Build and upload the ad supported app"
  lane :deployLite do
    build_ipa(APPS[:lite])
    upload_ipa(APPS[:lite]) unless dry_run?
  end

  desc "Print the build number both apps would get"
  lane :resolveBuildNumber do
    key_path = api_key_file
    begin
      number = next_build_number(key: asc_key(path: key_path))
      UI.message("building both apps as build #{number}")
      github_output("build_number", number)
      number
    ensure
      FileUtils.remove_entry(File.dirname(key_path), true)
    end
  end

  lane :tests do
    run_tests(
      project: "OpenDocumentReader.xcodeproj",
      scheme: "ODR Full",
      prelaunch_simulator: true
    )
  end

  # Decode the API key into a private temporary file; callers remove it.
  private_lane :api_key_file do
    path = File.join(Dir.mktmpdir("asc-api-key"), "AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
    File.write(path, Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))
    File.chmod(0o600, path)

    path
  end

  private_lane :asc_key do |options|
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: options[:path],
      in_house: false
    )
  end

  # One above the highest either app has, so one (version, build) pair names one
  # commit in both listings. The store only requires the number to increase.
  private_lane :next_build_number do |options|
    APPS.values.map { |app|
      latest_testflight_build_number(
        api_key: options[:key],
        app_identifier: app[:app_identifier],
        initial_build_number: 0
      )
    }.max + 1
  end

  # Read version and build from the environment; resolve an unset build number from the store.
  private_lane :build_ipa do |options|
    version = ENV["ODR_VERSION"].to_s.strip

    # Require a version for local uploads as well as CI.
    if version.empty? && !dry_run?
      UI.user_error!(
        "no version to build: set ODR_VERSION (e.g. ODR_VERSION=1.36), " \
        "or ODR_DRY_RUN=true to build without uploading"
      )
    end

    key_path = api_key_file
    profile_dir = nil

    begin
      key = asc_key(path: key_path)

      build_number = ENV["ODR_BUILD_NUMBER"].to_s.strip
      build_number = next_build_number(key: key) if build_number.empty?

      UI.message("building #{options[:scheme]} #{version.empty? ? '(unversioned)' : version} as build #{build_number}")

      # Use manual signing and fetch the provisioning profile before building.
      profile_dir = Dir.mktmpdir("provisioning-profile")
      get_provisioning_profile(
        api_key: key,
        app_identifier: options[:app_identifier],
        # out of the working tree; sigh installs a copy where xcodebuild looks
        output_path: profile_dir
      )
      profile_name = lane_context[SharedValues::SIGH_NAME]
      UI.user_error!("sigh returned no profile name") if profile_name.to_s.empty?

      xcargs = [
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=#{Shellwords.escape('Apple Distribution')}",
        "PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_name)}",
        # on the command line, so a release never leaves the working tree dirty
        "CURRENT_PROJECT_VERSION=#{build_number}",
      ]
      # left out rather than passed as the 0.0.0 project.pbxproj already says
      xcargs << "MARKETING_VERSION=#{Shellwords.escape(version)}" unless version.empty?

      build_app(
        project: "OpenDocumentReader.xcodeproj",
        scheme: options[:scheme],
        export_method: "app-store",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: { options[:app_identifier] => profile_name },
        },
        xcargs: xcargs.join(" "),
        # a name per app: one job builds both, and gym would otherwise write one
        # over the other
        output_directory: IPA_DIR,
        output_name: "#{options[:name]}.ipa"
      )
    ensure
      FileUtils.remove_entry(File.dirname(key_path), true)
      FileUtils.remove_entry(profile_dir, true) if profile_dir
    end
  end

  # Takes the .ipa built earlier rather than building one, so a failed upload can
  # be retried against the same bytes.
  private_lane :upload_ipa do |options|
    ipa = File.join(IPA_DIR, "#{options[:name]}.ipa")
    UI.user_error!("no #{ipa} to upload - run the matching build lane first") unless File.exist?(ipa)

    key_path = api_key_file
    begin
      upload_to_app_store(
        api_key: asc_key(path: key_path),
        app_identifier: options[:app_identifier],
        ipa: ipa,
        skip_screenshots: true,
        skip_metadata: true,
        # Upload without submitting for review.
        submit_for_review: false,
        # deliver runs precheck even when it is not submitting, and precheck
        # refuses to run at all against in-app purchases with an API key
        run_precheck_before_submit: false
      )
    ensure
      FileUtils.remove_entry(File.dirname(key_path), true)
    end
  end

  # Stage and upload version notes and app-specific listing metadata separately from the binary.
  private_lane :upload_listing do |options|
    version = ENV["ODR_VERSION"].to_s.strip
    UI.user_error!("no version to write notes for: set ODR_VERSION (e.g. ODR_VERSION=1.41)") if version.empty?

    notes_dir = Dir.mktmpdir("release-notes")
    shots_dir = Dir.mktmpdir("release-screenshots")
    key_path = nil

    begin
      # first, so a version some locale has no copy for fails before a key is
      # ever written to disk
      sh(STORE_LISTING, "--version", version, "--stage", notes_dir, "--app", options[:name])

      # Upload text alone when no screenshots exist; otherwise require a complete set.
      captured = !Dir.glob(File.join(FRAMED_DIR, "*", "*.png")).empty?
      sh(STORE_SCREENSHOTS, "--screenshots", FRAMED_DIR, "--stage", shots_dir, "--app", options[:name]) if captured
      UI.important("no screenshots under #{FRAMED_DIR} - writing the text only") unless captured

      key_path = api_key_file

      upload_to_app_store(
        api_key: asc_key(path: key_path),
        app_identifier: options[:app_identifier],
        # creates the version when App Store Connect has none yet, which is the
        # usual case: the build is still processing when this runs
        app_version: version,
        metadata_path: notes_dir,
        screenshots_path: shots_dir,
        skip_binary_upload: true,
        skip_screenshots: !captured,
        skip_metadata: false,
        # the set replaces what is up there rather than joining it, or a locale
        # keeps whichever of last release's pictures this one has no answer to
        overwrite_screenshots: captured,
        # deliver otherwise opens an HTML preview and waits to be told it is fine
        force: true,
        # same as the binary upload: precheck cannot read in-app purchases with
        # an API key, and nothing is being submitted here either
        run_precheck_before_submit: false,
        submit_for_review: false
      )
    ensure
      FileUtils.remove_entry(File.dirname(key_path), true) if key_path
      FileUtils.remove_entry(notes_dir, true)
      FileUtils.remove_entry(shots_dir, true)
    end
  end
end
